# Required for WhisperX diarization.
HF_TOKEN=

# Optional but recommended for PubMed E-utilities.
NCBI_API_KEY=

# Required only when using --deliver-target discord:CHANNEL_ID.
DISCORD_BOT_TOKEN=

# Optional LLM/Codex/Hermes settings.
WARD_CODEX_BIN=codex
HERMES_HOME=~/.hermes
WARD_OPENEVIDENCE_PROVIDER=browser
WARD_OPENEVIDENCE_MCP_COMMAND=
WARD_OPENEVIDENCE_MCP_TIMEOUT=120
WARD_HEALTH_DISCORD_TARGET=

# Local runtime paths. Relative defaults are resolved from this repository.
INCOMING_DIR=./data/incoming_audio
OUTPUT_DIR=./data/output
LOG_DIR=./data/logs
CASE_VIEW_DIR=./data/case_views
OBSIDIAN_VAULT_DIR=./data/obsidian_vault
WARD_STT_REVIEW_QUEUE_DIR=./data/stt_review_queue
WARD_AUDIO_ARCHIVE_DIR=./data/ward_audio_archive
WARD_OPENEVIDENCE_SESSION_DIR=./data/openevidence

WARD_TIMEZONE=Asia/Taipei
