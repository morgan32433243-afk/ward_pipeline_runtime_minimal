{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Literature Taxonomy",
  "type": "object",
  "required": ["version", "items"],
  "properties": {
    "version": {"type": "string"},
    "taxonomy_type": {"type": "string"},
    "queue_type": {"type": "string"},
    "description": {"type": "string"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "label", "keywords"],
        "properties": {
          "key": {"type": "string"},
          "status": {"type": "string"},
          "kind": {"enum": ["service", "diagnosis"]},
          "label": {"type": "string"},
          "specialty_primary": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "source_trace": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "keywords": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "examples": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "problem_keywords": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "keywords"],
        "properties": {
          "label": {"type": "string"},
          "keywords": {"type": "array", "items": {"type": "string"}, "minItems": 1}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
